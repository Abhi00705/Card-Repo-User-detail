<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./stylesheet/style_read.css">
    <!-- <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script> -->
    <title>Read</title>
</head>
<body>
    <div class="cont1">
        <a href="/">back to home</a>
        <div class="cont2">
    <%all_user.forEach((user)=>{%>
             <div class="cont3">
                
                    <div class="cont_img">
                        <%= console.log(user.image)%>
                        <img src="<%= user.image%>" alt="image">
                    </div>
                    <div class="cont_text">
                        <h6 class="cont_name"><%= user.name%></h6>
                        <h6 class="cont_email"><%= user.email%></h6>
                        <a href="/edit?email=<%= user.email %>">Edit</a>
                        <a href="/delete?email=<%= user.email %>">Delete</a>
                    </div>
                
            </div>
    <%})%>
            
        </div>
    </div>
</body>
</html>